VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Откуда сайт берёт картинки к вопросам.
# По умолчанию /sat_images/ — файлы из public/sat_images.
# Если картинки залиты в Supabase Storage (scripts/sat_parser/upload_images.py),
# впиши сюда ссылку, которую он напечатал в конце:
# VITE_SAT_IMAGE_BASE=https://your-project-ref.supabase.co/storage/v1/object/public/sat-images/

# Optional server-side explicit vars (API reads these first if provided)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Нужен только для заливки картинок в Storage (upload_images.py). НЕ anon.
# SUPABASE_SERVICE_KEY=your-service-role-key
# SUPABASE_BUCKET=sat-images
